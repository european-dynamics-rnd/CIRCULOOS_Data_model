{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "biomass_evop",
  "derivedFrom": "",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/biomass_evop/MaterialOffer/schema.json",
  "title": "Data model for an EVOP material offer",
  "description": "CIRCULOOS data model for an offer of surplus biomass made available to other organisations in the EVOP circular supply chain, covering the quantity offered, the safety margin retained and the inventory the offer derives from.",
  "type": "object",
  "definitions": {
    "BooleanProperty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "boolean"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DateTimeProperty": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "QuantityProperty": {
      "anyOf": [
        {
          "description": "Exact value as a number, or a range as an object with minValue and/or maxValue.",
          "anyOf": [
            {
              "type": "number",
              "description": "Exact measured value, when a single figure is known."
            },
            {
              "type": "object",
              "properties": {
                "minValue": {
                  "type": "number",
                  "description": "Lower bound of the value, when the source declares a range or a minimum."
                },
                "maxValue": {
                  "type": "number",
                  "description": "Upper bound of the value, when the source declares a range or a maximum."
                }
              },
              "minProperties": 1,
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "description": "Exact value as a number, or a range as an object with minValue and/or maxValue.",
              "anyOf": [
                {
                  "type": "number",
                  "description": "Exact measured value, when a single figure is known."
                },
                {
                  "type": "object",
                  "properties": {
                    "minValue": {
                      "type": "number",
                      "description": "Lower bound of the value, when the source declares a range or a minimum."
                    },
                    "maxValue": {
                      "type": "number",
                      "description": "Upper bound of the value, when the source declares a range or a maximum."
                    }
                  },
                  "minProperties": 1,
                  "additionalProperties": false
                }
              ]
            },
            "unitCode": {
              "type": "string",
              "description": "Unit of measurement of the value, given as a UN/CEFACT code where one exists."
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "unitCode",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RelationshipProperty": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Relationship"
              ]
            },
            "object": {
              "type": "string",
              "pattern": "^urn:ngsi-ld:.+$",
              "description": "URN of the referenced entity."
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false
        }
      ]
    },
    "StringProperty": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "string"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:evop:material-offer:<material>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be MaterialOffer",
          "enum": [
            "MaterialOffer"
          ]
        },
        "material": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Identifies the biomass material being offered, such as olive pits."
        },
        "availableForOthers": {
          "allOf": [
            {
              "$ref": "#/definitions/BooleanProperty"
            }
          ],
          "description": "Property. Indicates whether the material is available for use or purchase by other organisations through the circular supply chain."
        },
        "availableQuantityKg": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: KGM. Quantity of the material currently available for other users."
        },
        "quantityUnit": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Unit used to express the available material quantity, e.g. kg."
        },
        "offerPercentage": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: P1. Percentage of the available inventory quantity that is intended to be offered to other users."
        },
        "safetyMarginPercent": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: P1. Percentage of stock reserved as a safety margin and therefore not intended to be offered."
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Current status of the material offer, indicating whether it is available or otherwise unavailable."
        },
        "sourceInventory": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the inventory record from which the material offer quantity is derived."
        },
        "updatedAt": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the material offer information was last updated."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "material",
    "availableForOthers",
    "status"
  ]
}
