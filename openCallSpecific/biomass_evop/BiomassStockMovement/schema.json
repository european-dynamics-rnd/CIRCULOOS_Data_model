{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "biomass_evop",
  "derivedFrom": "",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/biomass_evop/BiomassStockMovement/schema.json",
  "title": "Data model for an EVOP biomass stock movement",
  "description": "CIRCULOOS data model for a single stock movement of biomass in the EVOP value chain, recording the material, the kind of movement, the quantity moved and the batch or source record it relates to.",
  "type": "object",
  "definitions": {
    "DateTimeProperty": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "QuantityProperty": {
      "anyOf": [
        {
          "description": "Exact value as a number, or a range as an object with minValue and/or maxValue.",
          "anyOf": [
            {
              "type": "number",
              "description": "Exact measured value, when a single figure is known."
            },
            {
              "type": "object",
              "properties": {
                "minValue": {
                  "type": "number",
                  "description": "Lower bound of the value, when the source declares a range or a minimum."
                },
                "maxValue": {
                  "type": "number",
                  "description": "Upper bound of the value, when the source declares a range or a maximum."
                }
              },
              "minProperties": 1,
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "description": "Exact value as a number, or a range as an object with minValue and/or maxValue.",
              "anyOf": [
                {
                  "type": "number",
                  "description": "Exact measured value, when a single figure is known."
                },
                {
                  "type": "object",
                  "properties": {
                    "minValue": {
                      "type": "number",
                      "description": "Lower bound of the value, when the source declares a range or a minimum."
                    },
                    "maxValue": {
                      "type": "number",
                      "description": "Upper bound of the value, when the source declares a range or a maximum."
                    }
                  },
                  "minProperties": 1,
                  "additionalProperties": false
                }
              ]
            },
            "unitCode": {
              "type": "string",
              "description": "Unit of measurement of the value, given as a UN/CEFACT code where one exists."
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "unitCode",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RelationshipProperty": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Relationship"
              ]
            },
            "object": {
              "type": "string",
              "pattern": "^urn:ngsi-ld:.+$",
              "description": "URN of the referenced entity."
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false
        }
      ]
    },
    "StringProperty": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Property"
              ]
            },
            "value": {
              "type": "string"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:evop:biomass-stock-movement:<movementId>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be BiomassStockMovement",
          "enum": [
            "BiomassStockMovement"
          ]
        },
        "material": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Identifies the biomass material involved in the stock movement, such as olive pits."
        },
        "movementType": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Indicates the type of stock movement recorded, such as receipt, consumption or transfer."
        },
        "quantityKg": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: KGM. Quantity of biomass involved in the stock movement."
        },
        "occurredAt": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the biomass stock movement occurred, recorded as a timestamp."
        },
        "sourceRef": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Reference identifying the source or origin of the stock movement, such as an initial stock record or measurement source."
        },
        "relatedEntityId": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the biomass batch or other EVOP entity associated with the stock movement."
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Free-text description providing additional information about the stock movement, including the biomass type or test context."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "material",
    "movementType",
    "quantityKg",
    "occurredAt"
  ]
}
