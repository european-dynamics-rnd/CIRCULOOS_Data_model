{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "yeast",
  "derivedFrom": "",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/yeast/Company/schema.json",
  "title": "Data model for a Yeast2Value company",
  "description": "CIRCULOOS data model for a company taking part in the Yeast2Value value chain, covering its identity, postal address, industry sectors and the role it plays in valorising brewer's spent yeast.",
  "type": "object",
  "definitions": {
    "AddressProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "object",
          "properties": {
            "streetAddress": {
              "type": "string",
              "description": "The street address. Model:'https://schema.org/streetAddress'"
            },
            "addressLocality": {
              "type": "string",
              "description": "The locality in which the street address is. Model:'https://schema.org/addressLocality'"
            },
            "addressRegion": {
              "type": "string",
              "description": "The region in which the locality is. Model:'https://schema.org/addressRegion'"
            },
            "addressCountry": {
              "type": "string",
              "description": "The country. Model:'https://schema.org/addressCountry'"
            },
            "postalCode": {
              "type": "string",
              "description": "The postal code. Model:'https://schema.org/postalCode'"
            }
          },
          "additionalProperties": false
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "StringArrayProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:circuloos-yeast2value:Company:<companyId>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be Company",
          "enum": [
            "Company"
          ]
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Legal or trading name of the company."
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Short description of the company's activities and its role in valorising brewer's spent yeast."
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/definitions/AddressProperty"
            }
          ],
          "description": "Property. Postal address of the company as a structured object (street, locality, region, country, postal code), following the schema.org PostalAddress format."
        },
        "category": {
          "allOf": [
            {
              "$ref": "#/definitions/StringArrayProperty"
            }
          ],
          "description": "Property. List of sectors or industry categories the company operates in."
        },
        "valueChainRole": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Role of the company in the Yeast2Value value chain (e.g. feedstock supplier, processor, customer/off-taker)."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "name",
    "valueChainRole"
  ]
}
