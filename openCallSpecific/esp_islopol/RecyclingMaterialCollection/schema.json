{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "esp_islopol",
  "derivedFrom": "https://context.dataspace-arditi.com/islopol/entities/RecyclingMaterialCollection/v2/schema.json",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/esp_islopol/RecyclingMaterialCollection/schema.json",
  "title": "Data model for an ISLOPOL recycling material collection",
  "description": "CIRCULOOS data model for a material collection or reception movement in the ISLOPOL value chain, covering the client and transporter involved, the vehicle used, the waste code and stream, the origin and destination, and the mass received.",
  "type": "object",
  "definitions": {
    "DateTimeProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "QuantityProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "number",
          "description": "Exact measured value, when a single figure is known."
        },
        "minValue": {
          "type": "number",
          "description": "Lower bound of the value, when the source declares a range or a minimum."
        },
        "maxValue": {
          "type": "number",
          "description": "Upper bound of the value, when the source declares a range or a maximum."
        },
        "unitCode": {
          "type": "string",
          "description": "Unit of measurement of the value, given as a UN/CEFACT code where one exists."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "unitCode"
      ],
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "minValue"
          ]
        },
        {
          "required": [
            "maxValue"
          ]
        }
      ],
      "additionalProperties": false
    },
    "RelationshipProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "WasteStreamProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "enum": [
            "Blue Stream",
            "Yellow Stream",
            "EPS Stream",
            "Rejected EPS Stream",
            "Paper/Cardboard Stream",
            "Other"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:RecyclingMaterialCollection:<facility>:<kind>:<timestamp>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be RecyclingMaterialCollection",
          "enum": [
            "RecyclingMaterialCollection"
          ]
        },
        "movementKind": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Type of material movement or operation."
        },
        "client": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Name of the client associated with the material movement."
        },
        "clientType": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Client classification code."
        },
        "transporter": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Name of the organisation responsible for transporting the material in the recorded movement."
        },
        "vehiclePlateIdentifier": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Vehicle registration plate or other vehicle identifier recorded in the source document."
        },
        "refVehicle": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the Vehicle entity associated with the material movement."
        },
        "lerCode": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. European List of Waste code."
        },
        "product": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Material or waste description."
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Place, municipality or source site from which the collected material originated."
        },
        "destination": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Receiving site, treatment route or sorting destination recorded for the material movement."
        },
        "timestampDeparture": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the material movement departed, expressed as an ISO 8601 timestamp."
        },
        "timestampArrival": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time of the recorded arrival or reception of the material, expressed as an ISO 8601 timestamp."
        },
        "distance": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: KMT. Distance travelled by the collection movement."
        },
        "weight": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: KGM. Mass of material recorded for the movement."
        },
        "wasteStream": {
          "allOf": [
            {
              "$ref": "#/definitions/WasteStreamProperty"
            }
          ],
          "description": "Property. Classification of the collected material stream: Blue Stream, Yellow Stream, EPS Stream, Rejected EPS Stream, Paper/Cardboard Stream, Other."
        },
        "refFactoryOrigin": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. ARM Factory the collection movement departs from, when it departs from an ARM facility."
        },
        "refFactoryDestination": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. ARM Factory the collection movement arrives at, when it arrives at an ARM facility."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "weight"
  ]
}
