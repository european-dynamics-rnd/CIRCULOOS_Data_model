{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "esp_islopol",
  "derivedFrom": "https://context.dataspace-arditi.com/islopol/entities/Product/v2/schema.json",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/esp_islopol/Product/schema.json",
  "title": "Data model for an ISLOPOL product record",
  "description": "CIRCULOOS data model for a recorded quantity of material, energy, a consumable or a finished product used or produced in the ISLOPOL value chain, covering its quantity and unit, its supplier and destination, its physical dimensions and the process event it belongs to.",
  "type": "object",
  "definitions": {
    "QuantityProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "number",
          "description": "Exact measured value, when a single figure is known."
        },
        "minValue": {
          "type": "number",
          "description": "Lower bound of the value, when the source declares a range or a minimum."
        },
        "maxValue": {
          "type": "number",
          "description": "Upper bound of the value, when the source declares a range or a maximum."
        },
        "unitCode": {
          "type": "string",
          "description": "Unit of measurement of the value, given as a UN/CEFACT code where one exists."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "unitCode"
      ],
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "minValue"
          ]
        },
        {
          "required": [
            "maxValue"
          ]
        }
      ],
      "additionalProperties": false
    },
    "RelationshipProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "StringArrayProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:Product:<facility>:<material>:<date>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be Product",
          "enum": [
            "Product"
          ]
        },
        "refProcessEvent": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the ProcessEvent associated with this Product record, linking its material or resource to the corresponding operation."
        },
        "refProductModel": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the ProductModel defining the product's shared characteristics, such as its material, category and default unit of measurement."
        },
        "supplier": {
          "allOf": [
            {
              "$ref": "#/definitions/StringArrayProperty"
            }
          ],
          "description": "Property. Names or identifiers of the organisations or sources supplying the product or material."
        },
        "destination": {
          "allOf": [
            {
              "$ref": "#/definitions/StringArrayProperty"
            }
          ],
          "description": "Property. Names or identifiers of the intended recipients, facilities or destinations for the product or material."
        },
        "quantity": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: KGM, KWH, HUR or EA. Amount of the product, material or resource represented by the record."
        },
        "length": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: CMT. Physical length of the product."
        },
        "width": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: CMT. Physical width of the product."
        },
        "thickness": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: CMT. Physical thickness of the product."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "refProductModel",
    "quantity"
  ]
}
