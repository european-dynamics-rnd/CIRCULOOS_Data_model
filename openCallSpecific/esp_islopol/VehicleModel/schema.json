{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "esp_islopol",
  "derivedFrom": "https://context.dataspace-arditi.com/islopol/entities/VehicleModel/v2/schema.json",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/esp_islopol/VehicleModel/schema.json",
  "title": "Data model for an ISLOPOL vehicle model",
  "description": "CIRCULOOS data model for a vehicle model in the ISLOPOL value chain, grouping the technical characteristics shared by vehicles of that model, including brand, fuel type, cargo volume and weight.",
  "type": "object",
  "definitions": {
    "FuelTypeProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "enum": [
            "autogas",
            "biodiesel",
            "cng",
            "diesel",
            "electric",
            "ethanol",
            "gasoline",
            "hybrid_electric_diesel",
            "hybrid_electric_petrol",
            "hydrogen",
            "lpg",
            "petrol",
            "petrol(unleaded)",
            "petrol(leaded)",
            "other"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "QuantityProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "number",
          "description": "Exact measured value, when a single figure is known."
        },
        "minValue": {
          "type": "number",
          "description": "Lower bound of the value, when the source declares a range or a minimum."
        },
        "maxValue": {
          "type": "number",
          "description": "Upper bound of the value, when the source declares a range or a maximum."
        },
        "unitCode": {
          "type": "string",
          "description": "Unit of measurement of the value, given as a UN/CEFACT code where one exists."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "unitCode"
      ],
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "minValue"
          ]
        },
        {
          "required": [
            "maxValue"
          ]
        }
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:VehicleModel:<brand>_<model>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be VehicleModel",
          "enum": [
            "VehicleModel"
          ]
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Human-readable name of the vehicle model, typically combining the brand and model designation. Given in the source as https://schema.org/name."
        },
        "brandName": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Brand or marque of the vehicle model."
        },
        "modelName": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Manufacturer's model designation."
        },
        "fuelType": {
          "allOf": [
            {
              "$ref": "#/definitions/FuelTypeProperty"
            }
          ],
          "description": "Property. Fuel or energy type used by vehicles of this model. Given in the source as https://schema.org/fuelType."
        },
        "cargoVolume": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: LTR. Cargo volume specified for the vehicle model."
        },
        "weight": {
          "allOf": [
            {
              "$ref": "#/definitions/QuantityProperty"
            }
          ],
          "description": "Property. Expected unitCode: KGM. Vehicle weight recorded for the model. Given in the source as https://schema.org/weight."
        }
      }
    }
  ],
  "required": [
    "id",
    "type"
  ]
}
