{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "",
  "derivedFrom": "https://context.dataspace-arditi.com/islopol/entities/EPSBatch/v2/schema.json",
  "license": "",
  "$id": "https://raw.githubusercontent.com/TO_ADD_LATER/schema.json",
  "title": "Data model for an ISLOPOL expanded polystyrene batch",
  "description": "CIRCULOOS data model for a batch of expanded polystyrene (EPS) tracked through collection, transport and recycling in the ISLOPOL value chain, covering its handling status, its rejection and contamination figures, and the observations that characterise it.",
  "type": "object",
  "definitions": {
    "DateTimeProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "FractionProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "RelationshipArrayProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:ngsi-ld:.+$"
          },
          "minItems": 1,
          "description": "URNs of the referenced entities."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "RelationshipProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:EPSBatch:<facility>:<date>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be EPSBatch",
          "enum": [
            "EPSBatch"
          ]
        },
        "refProduct": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the Product entity representing the EPS material in this batch, including its recorded quantity and unit of measurement."
        },
        "rejectionRate": {
          "allOf": [
            {
              "$ref": "#/definitions/FractionProperty"
            }
          ],
          "description": "Property. Fraction of material in the batch that was rejected, expressed on a scale from 0 to 1. (Multiply by 100 to obtain the rejection percentage.)"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Current stage of the batch in the operational workflow, such as awaiting transport. It describes the batch's handling status rather than its contamination level."
        },
        "avgContaminationScore": {
          "allOf": [
            {
              "$ref": "#/definitions/FractionProperty"
            }
          ],
          "description": "Property. Average contamination score associated with the batch, expressed from 0 to 1, where higher values indicate greater contamination. (Multiply by 100 to obtain the Contamination Score percentage.)"
        },
        "refEPSObservations": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipArrayProperty"
            }
          ],
          "description": "Relationship. Identifiers of the EPSObservation entities associated with this batch. These records provide the automated contamination assessments used to characterise it."
        },
        "dateCreated": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the EPSBatch record was created, expressed as an ISO 8601 timestamp. This is the record creation time, which can differ from the time of the physical operation."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "refProduct",
    "status"
  ]
}
