{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "esp_islopol",
  "derivedFrom": "https://context.dataspace-arditi.com/islopol/entities/ProductionRun/v2/schema.json",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/esp_islopol/ProductionRun/schema.json",
  "title": "Data model for an ISLOPOL production run",
  "description": "CIRCULOOS data model for a specific production or transformation run in the ISLOPOL value chain, covering the period over which it ran, the process performed and the input and output products involved.",
  "type": "object",
  "definitions": {
    "DateTimeProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "RelationshipArrayProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^urn:ngsi-ld:.+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:ngsi-ld:.+$"
              },
              "minItems": 1
            }
          ],
          "description": "URN of the referenced entity, or a list of URNs."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "RelationshipProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:ProductionRun:<facility>:<process>:<timestamp>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be ProductionRun",
          "enum": [
            "ProductionRun"
          ]
        },
        "startDate": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the production run actually started, expressed as an ISO 8601 timestamp. This can differ from the date embedded in the record identifier."
        },
        "endDate": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the production run actually ended, expressed as an ISO 8601 timestamp. Together with startDate, it defines the recorded duration of the run."
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Human-readable description of the production run or operator notes."
        },
        "refProcess": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the Process entity defining the production or transformation operation performed during the run."
        },
        "refInputProducts": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipArrayProperty"
            }
          ],
          "description": "Relationship. Identifiers of the Product entities used during the production run. The referenced Product records specify input quantities and units."
        },
        "refOutputProducts": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipArrayProperty"
            }
          ],
          "description": "Relationship. Identifiers of the Product entities produced by the run. The referenced Product records specify output quantities and units."
        },
        "refLcaId": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Reference identifier used for LCA traceability."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "startDate",
    "endDate"
  ]
}
