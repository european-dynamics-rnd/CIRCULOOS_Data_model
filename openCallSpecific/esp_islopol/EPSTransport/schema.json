{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "esp_islopol",
  "derivedFrom": "https://context.dataspace-arditi.com/islopol/entities/EPSTransport/v2/schema.json",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/esp_islopol/EPSTransport/schema.json",
  "title": "Data model for an ISLOPOL EPS transport operation",
  "description": "CIRCULOOS data model for a transport operation carrying one or more EPS batches between facilities in the ISLOPOL value chain, covering departure and arrival times, the origin and destination facilities, the vehicle used and the batches shipped.",
  "type": "object",
  "definitions": {
    "DateTimeProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "RelationshipArrayProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^urn:ngsi-ld:.+$"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:ngsi-ld:.+$"
              },
              "minItems": 1
            }
          ],
          "description": "URN of the referenced entity, or a list of URNs."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    },
    "RelationshipProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Relationship"
          ]
        },
        "object": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:.+$",
          "description": "URN of the referenced entity."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:EPSTransport:<transportId>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be EPSTransport",
          "enum": [
            "EPSTransport"
          ]
        },
        "departureTime": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the EPS shipment departed from the origin facility, expressed as an ISO 8601 timestamp."
        },
        "arrivalTime": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Date and time when the EPS shipment arrived at the destination facility, expressed as an ISO 8601 timestamp."
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the Factory entity representing the facility from which the EPS shipment departs."
        },
        "destination": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the Factory entity representing the facility receiving the EPS shipment, such as Esferolight."
        },
        "refVehicle": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipProperty"
            }
          ],
          "description": "Relationship. Identifier of the Vehicle entity used to carry the EPS shipment."
        },
        "refEPSBatch": {
          "allOf": [
            {
              "$ref": "#/definitions/RelationshipArrayProperty"
            }
          ],
          "description": "Relationship. Identifiers of the EPSBatch entities included in the shipment. A single transport operation can therefore carry material from several batches."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "refEPSBatch",
    "departureTime",
    "refVehicle"
  ]
}
