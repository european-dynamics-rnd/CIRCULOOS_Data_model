{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "modelTags": "stainless_steel_dpp",
  "derivedFrom": "",
  "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
  "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/openCallSpecific/stainless_steel_dpp/StainlessSteelDPP/schema.json",
  "title": "Data model for stainless steel Digital Product Passport",
  "description": "CIRCULOOS data model for the Digital Product Passport of a stainless steel product, covering product identification, production time window and the manufacturing route the product goes through.",
  "type": "object",
  "definitions": {
    "DateTimeProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "RouteProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/RouteStep"
          },
          "description": "Property. Ordered list of the manufacturing operations the product goes through."
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "RouteStep": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "description": "Property. Name of the manufacturing operation performed in this route step, for example Plastic Injection Molding, Metal Cutting or Assembly."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date and time (ISO 8601, UTC) at which the operation was performed."
        },
        "productionStatus": {
          "type": "string",
          "description": "Property. Outcome of the operation as reported by the production line, for example OK."
        },
        "energyConsumption": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "description": "Property. Energy consumed by this route step."
            },
            "unitCode": {
              "type": "string",
              "description": "Property. UN/CEFACT code of the unit of the consumed energy, for example WHR (watt hour)."
            }
          },
          "required": [
            "value",
            "unitCode"
          ],
          "additionalProperties": false,
          "description": "Property. Energy consumed for this route step."
        }
      },
      "required": [
        "operation",
        "date",
        "productionStatus"
      ],
      "additionalProperties": false
    },
    "StringProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Property"
          ]
        },
        "value": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "description": "Property. Unique entity identifier, with the format urn:ngsi-ld:StainlessSteelDPP:<dppId>."
        },
        "type": {
          "type": "string",
          "description": "Property. NGSI Entity type. It has to be StainlessSteelDPP",
          "enum": [
            "StainlessSteelDPP"
          ]
        },
        "dppId": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Unique UUID of the Digital Product Passport of this product."
        },
        "factoryInternalBarcode": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Product unique identifier (barcode) assigned at the factory."
        },
        "productName": {
          "allOf": [
            {
              "$ref": "#/definitions/StringProperty"
            }
          ],
          "description": "Property. Commercial product name."
        },
        "startTime": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. Start time of the Digital Product Passport (ISO 8601 date-time, UTC)."
        },
        "endTime": {
          "allOf": [
            {
              "$ref": "#/definitions/DateTimeProperty"
            }
          ],
          "description": "Property. End time of the Digital Product Passport (ISO 8601 date-time, UTC)."
        },
        "route": {
          "allOf": [
            {
              "$ref": "#/definitions/RouteProperty"
            }
          ],
          "description": "Property. The processes the product goes through, each with its operation name, date, production status and energy consumption."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "dppId",
    "factoryInternalBarcode",
    "productName",
    "startTime",
    "route"
  ]
}
