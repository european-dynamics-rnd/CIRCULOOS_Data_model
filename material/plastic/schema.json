{
    "$schema": "http://json-schema.org/schema#",
    "$schemaVersion": "0.0.1",
    "modelTags": "",
    "derivedFrom": "",
    "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE",
    "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/material/plastic/schema.json",
    "title": "Data model for plastic",
    "description": "CIRCULOOS data model for raw plastic feedstock, covering the properties an injection molding factory needs to assess a batch before it goes into the hopper.",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
        },
        {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
        },
        {
            "$ref": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/material/circularity-commons.json#/definitions/Circularity-Commons"
        },
        {
            "properties": {
                "type": {
                    "description": "Property. NGSI Entity type. It has to be plastic",
                    "enum": [
                        "plastic"
                    ]
                },
                "polymerType": {
                    "type": "string",
                    "description": "Property. The polymer resin the material is made of. PO is a mixed polyolefin (PE/PP) fraction.",
                    "enum": [
                        "PP",
                        "HDPE",
                        "LDPE",
                        "PO",
                        "PET",
                        "PS",
                        "EPS",
                        "XPS",
                        "ABS",
                        "PVC",
                        "PC",
                        "PA",
                        "PBT",
                        "POM",
                        "PU",
                        "PLA",
                        "other"
                    ]
                },
                "materialForm": {
                    "type": "string",
                    "description": "Property. The physical form the raw material is delivered in, which determines how it can be fed into the hopper.",
                    "enum": [
                        "pellet",
                        "granulate",
                        "regrind",
                        "flake",
                        "powder"
                    ]
                },
                "origin": {
                    "type": "string",
                    "description": "Property. The source of the resin.",
                    "enum": [
                        "virgin",
                        "post-industrial recycled",
                        "post-consumer recycled",
                        "mixed"
                    ]
                },
                "color": {
                    "type": "string",
                    "description": "Property. The color of the raw material."
                },
                "density": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: g/cm3. The mass per unit volume of the solid resin. "
                },
                "bulkDensity": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: kg/m3. The density of the loose pellets/flakes as poured, needed to size the hopper and dosing. "
                },
                "meltFlowIndex": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: g/10min. Melt flow index (MFI/MFR), the key indicator of how easily the material flows into the mold cavity. "
                },
                "moistureContent": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: %. Residual moisture in the material; too high a value causes hydrolysis and surface defects if not dried before molding. "
                },
                "dryingRequired": {
                    "type": "boolean",
                    "description": "Property. Whether the material must be pre-dried before injection molding."
                },
                "recommendedDryingTemperature": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: °C. Recommended drying temperature before processing. "
                },
                "recommendedDryingTime": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: h. Recommended drying duration before processing. "
                },
                "meltingTemperature": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: °C. Melting (or processing) temperature of the resin. "
                },
                "recommendedBarrelTemperature": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: °C. Recommended injection molding barrel temperature for this material. "
                },
                "recommendedMoldTemperature": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: °C. Recommended mold (tool) temperature for this material. "
                },
                "shrinkageRate": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: %. Mold shrinkage of the material after cooling, needed to size the mold cavity. "
                },
                "tensileStrength": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: MPa. The maximum stress the molded material can withstand while being stretched before breaking. "
                },
                "flexuralModulus": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: MPa. Stiffness of the molded material under bending. "
                },
                "impactStrength": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: kJ/m2. Notched Izod impact strength of the molded material. "
                },
                "heatDeflectionTemperature": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: °C. Temperature at which the molded material deforms under a given load (HDT). "
                },
                "ashContent": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.  Default: 0.0"
                        }
                    },
                    "description": "Property. Unit: %. Inorganic filler/ash content left after incineration, an indicator of filler load and purity. "
                },
                "additives": {
                    "type": "string",
                    "description": "Property. Free text list of additives present in the compound, e.g. UV stabilizer, flame retardant, colorant masterbatch."
                },
                "wasteSource": {
                    "type": "string",
                    "enum": [
                        "packaging",
                        "WEEE",
                        "ELV",
                        "construction",
                        "agriculture",
                        "industrialScrap",
                        "other"
                    ],
                    "description": "Property. Waste stream the recycled material was collected from. WEEE (electronics) and ELV (end-of-life vehicles) streams may carry legacy brominated flame retardants."
                },
                "polymerPurity": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.",
                            "minimum": 0,
                            "maximum": 100
                        }
                    },
                    "description": "Property. Unit: %. Share of the target polymer in the material; the rest is other polymers and contaminants. "
                },
                "meltFlowIndexTestCondition": {
                    "type": "string",
                    "description": "Property. Test temperature and load the meltFlowIndex was measured at (ISO 1133), e.g. 230 °C / 2.16 kg. MFI values are not comparable without it."
                },
                "foodContactSuitable": {
                    "type": "boolean",
                    "description": "Property. Whether the recycled material may be used in food contact articles under Regulation (EU) 2022/1616."
                },
                "foodContactAuthorisation": {
                    "type": "string",
                    "description": "Property. Registration number of the recycling process or decontamination technology authorised under Regulation (EU) 2022/1616."
                },
                "recyclabilityGrade": {
                    "type": "string",
                    "enum": [
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                    ],
                    "description": "Property. Design-for-recycling performance grade of the packaging the material comes from or goes into, PPWR, Regulation (EU) 2025/40."
                }
            }
        }
    ],
    "required": [
        "id",
        "type",
        "polymerType",
        "materialForm"
    ]
}
