{
    "$schema": "http://json-schema.org/schema#",
    "modelTags": "",
    "$id": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/material/leather/schema.json",
    "$schemaVersion": "0.0.1",
    "title": "Data model for representing leather material",
    "description": "Representing leather material for the CIRCULOOS project",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
        },
        {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
        },
        {
            "$ref": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/main/material/circularity-commons.json#/definitions/Circularity-Commons"
        },
        {
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "leather"
                    ],
                    "description": "Property. NGSI Entity type. It has to be leather"
                },
                "origin": {
                    "type": "string",
                    "description": "Property. The source that the leather was originated",
                    "enum": [
                        "cow",
                        "pig",
                        "horse",
                        "other animals",
                        "vegan"
                    ]
                },
                "materialSource": {
                    "type": "string",
                    "enum": [
                        "preConsumerOffcut",
                        "productionScrap",
                        "postConsumer",
                        "deadstock"
                    ],
                    "description": "Property. Where the leather comes from in the value chain: cutting offcuts, tannery production scrap (shavings, trimmings), used products, or unsold stock."
                },
                "color": {
                    "type": "string",
                    "description": "Property. The final color of the leather."
                },
                "area": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.",
                            "minimum": 0
                        }
                    },
                    "description": "Property. Unit: given by unitCode, MTK (m2) or FTK (ft2, the usual leather trade unit). Usable surface area of the leather. "
                },
                "thickness": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "type": "number",
                            "description": "Property. https://schema.org/Number.",
                            "minimum": 0
                        }
                    },
                    "description": "Property. Unit: mm. The thickness of the leather. "
                },
                "pieceFormat": {
                    "type": "string",
                    "enum": [
                        "fullHide",
                        "side",
                        "bend",
                        "shoulder",
                        "belly",
                        "offcut"
                    ],
                    "description": "Property. Shape of the piece: a full hide, a standard cut of it, or an irregular offcut."
                },
                "tannedProcess": {
                    "type": "string",
                    "description": "Property. The tanning process used. chromeFree covers wet-white leather.",
                    "enum": [
                        "chrome",
                        "vegetable",
                        "chromeFree",
                        "aldehyde",
                        "synthetic",
                        "mixed"
                    ]
                },
                "leatherCut": {
                    "type": "string",
                    "description": "Property. The cut or surface of the leather: grain side, split, nubuck, suede or fur.",
                    "enum": [
                        "grainside",
                        "split",
                        "nubuck",
                        "suede",
                        "furs"
                    ]
                },
                "surfaceFinishWithCovering": {
                    "type": "boolean",
                    "description": "Property. Leather finished (with covering) or not finished"
                },
                "hardness": {
                    "type": "string",
                    "description": "Property. Overall hardness of the leather",
                    "enum": [
                        "soft",
                        "medium",
                        "hard"
                    ]
                }
            }
        }
    ],
    "required": [
        "id",
        "type",
        "color",
        "area"
    ],
    "license": "https://raw.githubusercontent.com/european-dynamics-rnd/CIRCULOOS_Data_model/refs/heads/main/LICENSE"
}
